# Copy to .env and replace API_KEY with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
APP_NAME="Strikers Club Chat API"
ENVIRONMENT=development
API_PREFIX=/api
API_KEY=replace-this-with-a-random-secret-at-least-32-characters

# Compose overrides the hostname with its private Redis service.
# For external Redis, disable RDB and AOF and do not mount persistent storage.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=strikers:items
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_MAX_CONNECTIONS=100

LOG_LEVEL=INFO
CORS_ORIGINS=[]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
MAX_REQUEST_BYTES=16384

# Chat / Responses API. Leave secrets blank until configured in your private .env.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_MAX_REQUEST_BYTES=33554432
OPENAI_TIMEOUT_SECONDS=45
EKT_API_BASE_URL=https://ekt.kz/api
EKT_API_USER=
EKT_API_PASSWORD=
UPSTREAM_TIMEOUT_SECONDS=15
UPSTREAM_MAX_RESPONSE_BYTES=2097152
CATALOG_CACHE_TTL_SECONDS=1800
DETAIL_CACHE_TTL_SECONDS=300
CATALOG_MAX_PAGES=50
CATALOG_MAX_PRODUCTS=10000

# All history, proposals and demo carts expire in Redis; no database or files.
CHAT_SESSION_TTL_SECONDS=3600
CHAT_TIMEOUT_SECONDS=90
CHAT_LOCK_TTL_SECONDS=120
CHAT_MAX_MESSAGES=40
CHAT_MAX_TOOL_ROUNDS=5
CHAT_MAX_TOOL_CALLS=16
CART_PROPOSAL_TTL_SECONDS=600
CART_MAX_OPERATIONS=100
CART_MAX_LINES=100
PURCHASE_CONDITIONS_PATH=app/data/purchase_conditions.json
EXTERNAL_SEARCH_ENABLED=false

# Uploads fail closed unless a ClamAV INSTREAM scanner is available.
# Start Compose profile 'uploads' and set UPLOAD_SCAN_HOST=clamav for attachments.
MAX_UPLOAD_MB=20
UPLOAD_SCAN_HOST=
UPLOAD_SCAN_PORT=3310
UPLOAD_SCAN_TIMEOUT_SECONDS=10
MAX_ARCHIVE_UNCOMPRESSED_MB=40
MAX_ARCHIVE_ENTRIES=1000

# Public browser settings. API keys must NEVER use the VITE_ prefix.
# Public browser settings. API keys must NEVER use the VITE_ prefix.
VITE_API_MODE=live
VITE_API_BASE_URL=/backend/api

# Server-only BFF settings. Copy API_KEY from the backend deployment here.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_PREFIX=/api
BACKEND_API_KEY=
# API_KEY is also accepted as a server-only fallback.

# Required behind an HTTPS reverse proxy; exact public origin, without a path.
# PUBLIC_ORIGIN=https://assistant.example.kz
# Standalone server: HOST=127.0.0.1, PORT=5173 by default.
